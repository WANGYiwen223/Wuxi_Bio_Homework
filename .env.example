# OpenAI-compatible endpoint; preserve the model identifier used by your provider.
HELPDESK_MODEL_BASE_URL=https://api.example.test/v1
HELPDESK_MODEL_API_KEY=replace-locally
HELPDESK_MODEL_NAME=your-tool-capable-model
HELPDESK_MODEL_TIMEOUT=60
# Includes reasoning tokens when the provider counts them in completion usage.
HELPDESK_MODEL_MAX_TOKENS=4096
# One empty/truncated-response recovery per turn, within MAX_MODEL_CALLS.
HELPDESK_MODEL_RECOVERY_MAX_TOKENS=8192
HELPDESK_MAX_MODEL_CALLS=8
HELPDESK_MAX_TOOL_CALLS=16
HELPDESK_MAX_CONTEXT_CHARS=48000
# Loopback-only demo application defaults.
HELPDESK_RUN_DIR=var/runs/mixed_issues
